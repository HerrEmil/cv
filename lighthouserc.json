{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "numberOfRuns": 3,
      "url": ["http://localhost/index.html", "http://localhost/sv/index.html", "http://localhost/de/index.html"]
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.92 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 180 }],
        "interactive": ["error", { "maxNumericValue": 2500 }],
        "uses-responsive-images": "off",
        "image-delivery-insight": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
